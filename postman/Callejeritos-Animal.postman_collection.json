{
  "info": {
    "_postman_id": "8f3c2a10-5d4e-4b7a-9c61-2e7d1b0a4f01",
    "name": "Callejeritos - Módulo Animal",
    "description": "Endpoints del módulo Animal.\n\n1. Cargar el seed: `node prisma/seed.js --reset`\n2. Importar esta colección y el environment \"Callejeritos - Local\"\n3. Ejecutar la carpeta \"00 - Setup\" y luego el resto en orden (o usar el Collection Runner).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Setup (ejecutar primero)",
      "description": "",
      "item": [
        {
          "name": "Obtener ids de los animales del seed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const animales = pm.response.json().data;",
                  "const id = (nombre) => { const a = animales.find((x) => x.nombre === nombre); return a ? String(a.idanimal) : ''; };",
                  "pm.test('El seed está cargado (10 animales)', () => pm.expect(animales.length).to.be.at.least(10));",
                  "pm.collectionVariables.set('animalConRelacionesId', id('Rocky'));   // tiene adopción + historial",
                  "pm.collectionVariables.set('animalConHistorialId', id('Canela'));   // tiene historial con veterinaria",
                  "pm.collectionVariables.set('animalSinRelacionesId', id('Firulais')); // se puede modificar/eliminar",
                  "const perro = animales.find((x) => x.nombre === 'Rocky');",
                  "const gato = animales.find((x) => x.nombre === 'Michi');",
                  "pm.collectionVariables.set('idEspeciePerro', String(perro.idespecie));",
                  "pm.collectionVariables.set('idEspecieGato', String(gato.idespecie));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/animales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "animales"
              ]
            },
            "description": "Guarda en variables de la colección los ids de animales del seed que usan las demás requests."
          }
        },
        {
          "name": "Obtener id de una veterinaria del seed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const registros = pm.response.json().data.flatMap((h) => h.registroatencionmedica);",
                  "const vet = registros.find((r) => r.responsable.tipo === 'VETERINARIA');",
                  "pm.test('Hay una veterinaria en el historial', () => pm.expect(vet).to.exist);",
                  "pm.collectionVariables.set('veterinariaId', String(vet.responsable.idresponsable));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/animales/{{animalConHistorialId}}/historial-clinico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "animales",
                "{{animalConHistorialId}}",
                "historial-clinico"
              ]
            },
            "description": "Toma el id de la veterinaria que atendió a Canela, para probar el filtro por veterinaria."
          }
        }
      ]
    },
