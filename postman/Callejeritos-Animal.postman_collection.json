            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const animal = pm.response.json().data;",
                  "pm.test('Se asignó estado inicial AVISTADO', () => pm.expect(animal.estado).to.eql('AVISTADO'));",
                  "pm.test('Incluye la especie', () => pm.expect(animal.especieanimal.nombre).to.eql('Perro'));",
